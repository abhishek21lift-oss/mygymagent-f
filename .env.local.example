# Copy to .env.local for local development.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Meta WhatsApp Embedded Signup
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=""
NEXT_PUBLIC_WHATSAPP_GRAPH_VERSION="v25.0"

# Web push (F-P1-1). Firebase console -> Project settings -> General ->
# Your apps -> Web app config, plus Cloud Messaging -> Web Push
# certificates -> key pair (the VAPID key). All five are public by design
# (they ship to every browser); the secret half is the service account on
# the API (FCM_SERVICE_ACCOUNT_JSON). Missing any one, the notification
# settings page says push isn't set up instead of offering a button.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Business details shown on /privacy, /terms, /refund-policy and /contact
# (src/lib/legal.ts). Unset ones render as "[... — to be published]".
# These pages are prerendered, so redeploy after changing them.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_SUPPORT_PHONE=
NEXT_PUBLIC_LEGAL_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_LEGAL_GRIEVANCE_OFFICER_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION_CITY=
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=
