# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# editor / manual backups (never commit these)
*.bak
*.bak[0-9]*
*.orig

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# swc
.swc/

# lockfiles / sync placeholders (npm is canonical: see vercel.json, Dockerfile, CI)
bun.lock
*.tmp

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
node_modules/
.e2e/results/
.e2e/cache/
.e2e/sessions/
.e2e/report.json
.e2e/ai-trace.json
.e2e/junit.xml
.e2e/summary.md
.e2e/logs/
.e2e/videos/
